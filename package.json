{
  "name": "tomallenux",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/fetch-content.mjs",
    "dev": "(npm run content || echo '[content] offline: using the last snapshot') && vite",
    "build": "npm run content && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "images": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:content": "node scripts/content-parity.mjs check",
    "test:e2e": "playwright test --pass-with-no-tests",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@mdi/js": "7.4.47",
    "@portabletext/vue": "^2.0.0",
    "@unhead/vue": "^3.4.3",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@portabletext/types": "^4.0.2",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
