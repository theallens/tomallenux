    {
      "_key": "329403e9e199",
      "_type": "section",
      "body": [
        {
          "_key": "84d933e34214",
          "_type": "columns",
          "align": "center",
          "columns": [
            {
              "_key": "d678950d3454",
              "_type": "column",
              "content": [
                {
                  "_key": "94ff3ae03631",
                  "_type": "block",
                  "children": [
                    {
                      "_key": "eb23306bc072",
                      "_type": "span",
                      "marks": [],
                      "text": "Refinements inspired by user insights"
                    }
                  ],
                  "markDefs": [],
                  "style": "h2"
                },
                {
                  "_key": "84082d7cbdb9",
                  "_type": "block",
                  "children": [
                    {
                      "_key": "8585ebec67c7",
                      "_type": "span",
                      "marks": [],
                      "text": "Driven by insights from survey and usability testing, we made several changes to the design:"
                    }
                  ],
                  "markDefs": [],
                  "style": "normal"
                },
